# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Type checkers and linters
.mypy_cache/
.ruff_cache/
.pyright/

# Secrets and local configuration: never commit
.env
.env.*
!.env.example
*.pem
# Public RDS CA bundle (not a secret); see certs/README.md
!certs/rds-global-bundle.pem
*.key
secrets/

# Local databases (synthetic data still stays out of git)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log
logs/

# Editor and OS files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Local tooling
.arko/
.claude/
.mcp.json

# DAST output (scripts/dast-scan.sh)
zap-report/
