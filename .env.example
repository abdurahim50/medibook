# MediBook configuration reference. Set as environment variables.
# Never put real secrets in this file.

# PostgreSQL connection (standard libpq variables)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=medibook
PGUSER=medibook
# PGPASSWORD=           set in your shell, never in a file
# PGSSLMODE=verify-full  with PGSSLROOTCERT=<CA bundle> when connecting to RDS

# Password for the demo patients created by `python -m app.seed`.
# Required by the seed command; never printed. Example: openssl rand -base64 18
# MEDIBOOK_SEED_PASSWORD=

# Seed command only: least-privilege role to create for the API (AWS: medibook_app).
# MEDIBOOK_APP_DB_USER=

# 1 = sign in with an RDS IAM token for PGUSER instead of PGPASSWORD (AWS only;
# needs AWS_REGION and the task role's credentials).
# MEDIBOOK_DB_IAM_AUTH=

# Seconds between background database checks; each failure logs
# "readiness check failed", which the database-unreachable alarm counts (F-12).
# Default 60; 0 turns the check off.
# MEDIBOOK_READINESS_PROBE_SECONDS=60

# Optional fixed UTC deadline for a controlled bootstrap, at most 15 minutes
# ahead. Default unset: failures alarm immediately. Restarts retain the same
# deadline; the first successful check ends grace early. Routine deployments
# run the migration before starting API tasks and do not set this variable.
# MEDIBOOK_READINESS_GRACE_UNTIL=2026-10-14T18:15:00Z
# MEDIBOOK_READINESS_GRACE_SECONDS=0  # legacy setting: nonzero is rejected
